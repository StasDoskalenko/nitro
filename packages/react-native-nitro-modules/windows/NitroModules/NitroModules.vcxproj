<?xml version="1.0" encoding="utf-8"?>
<!--
  react-native-nitro-modules for React Native Windows.

  Builds `NitroModules.dll` - the shared Nitro core (from `../../cpp`) plus the Windows
  platform layer and the `NitroModules` TurboModule. React Native Windows autolinks this
  project (see `../../react-native.config.js`); consuming Nitro modules link the resulting
  `NitroModules.lib` and only compile their own generated specs (see
  `../ConsumeNitroModules.props`). This mirrors the shared `libNitroModules.so` / framework
  used on Android / iOS.
-->
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(SolutionDir)\ExperimentalFeatures.props" Condition="Exists('$(SolutionDir)\ExperimentalFeatures.props')" />
  <PropertyGroup Label="Globals">
    <CppWinRTOptimized>true</CppWinRTOptimized>
    <MinimalCoreWin>true</MinimalCoreWin>
    <ProjectGuid>{2B9A6C31-6D4E-4C8A-9F1B-7E0A2D4C6B85}</ProjectGuid>
    <ProjectName>NitroModules</ProjectName>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>NitroModules</RootNamespace>
    <WindowsTargetPlatformVersion Condition="'$(WindowsTargetPlatformVersion)' == ''">10.0</WindowsTargetPlatformVersion>
    <DefaultLanguage>en-US</DefaultLanguage>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <AppxPackage>false</AppxPackage>
  </PropertyGroup>
  <PropertyGroup Label="NitroModulesProps">
    <ReactNativeWindowsDir Condition="'$(ReactNativeWindowsDir)' == ''">$([MSBuild]::GetDirectoryNameOfFileAbove($(SolutionDir), 'node_modules\react-native-windows\package.json'))\node_modules\react-native-windows\</ReactNativeWindowsDir>
    <NitroModulesDir Condition="'$(NitroModulesDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</NitroModulesDir>
    <NitroModulesCppDir>$(NitroModulesDir)cpp\</NitroModulesCppDir>
    <RunAutolinkCheck>false</RunAutolinkCheck>
    <RunCodegenWindows>false</RunCodegenWindows>
  </PropertyGroup>
  <Import Project="$(ReactNativeWindowsDir)\PropertySheets\External\Microsoft.ReactNative.WindowsSdk.Default.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <CharacterSet>Unicode</CharacterSet>
    <GenerateManifest>false</GenerateManifest>
    <PlatformToolset Condition="'$(PlatformToolset)' == '' or '$(PlatformToolset)' == 'v100'">$(DefaultPlatformToolset)</PlatformToolset>
    <PlatformToolset Condition="'$(VisualStudioVersion)' &gt;= '18.0' and ('$(PlatformToolset)' == '' or '$(PlatformToolset)' == 'v100')">v145</PlatformToolset>
    <PlatformToolset Condition="'$(VisualStudioVersion)' &gt;= '17.0' and ('$(PlatformToolset)' == '' or '$(PlatformToolset)' == 'v100')">v143</PlatformToolset>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <ImportGroup Label="ReactNativeWindowsPropertySheets">
    <Import Project="$(ReactNativeWindowsDir)\PropertySheets\External\Microsoft.ReactNative.CppLib.props" Condition="Exists('$(ReactNativeWindowsDir)\PropertySheets\External\Microsoft.ReactNative.CppLib.props')" />
    <!-- Match the CRT model of the consuming RNW app. Since RNW 0.85 the Composition
         (Win32) app template links the "hybrid" CRT (static vcruntime + STL, dynamic
         UCRT) via HybridCRT.props. NitroModules.dll exchanges std:: objects
         (strings, functions, shared_ptr) across the DLL boundary, so it must use the
         exact same model - a plain /MDd DLL against a hybrid-CRT app corrupts the
         heap and fast-fails during instance init. -->
    <Import Project="$(ReactNativeWindowsDir)\PropertySheets\HybridCRT.props" Condition="Exists('$(ReactNativeWindowsDir)\PropertySheets\HybridCRT.props')" />
  </ImportGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <PrecompiledHeaderOutputFile>$(IntDir)pch.pch</PrecompiledHeaderOutputFile>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <ForcedIncludeFiles>NitroMsvcStdCompat.h</ForcedIncludeFiles>
      <AdditionalOptions>%(AdditionalOptions) /bigobj /Zc:__cplusplus</AdditionalOptions>
      <!-- 4251/4275: STL/base types across the DLL boundary - safe because every module in
           an RNW app is built with one toolset. -->
      <DisableSpecificWarnings>4068;4100;4244;4251;4267;4275;4453;4715;28204</DisableSpecificWarnings>
      <PreprocessorDefinitions>_WINRT_DLL;NITRO_BUILDING_SHARED_LIBRARY;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalUsingDirectories>$(WindowsSDK_WindowsMetadata);$(AdditionalUsingDirectories)</AdditionalUsingDirectories>
      <AdditionalIncludeDirectories>
        $(MSBuildThisFileDirectory);
        $(MSBuildThisFileDirectory)..\include;
        $(NitroModulesCppDir)core;
        $(NitroModulesCppDir)entrypoint;
        $(NitroModulesCppDir)jsi;
        $(NitroModulesCppDir)platform;
        $(NitroModulesCppDir)prototype;
        $(NitroModulesCppDir)registry;
        $(NitroModulesCppDir)templates;
        $(NitroModulesCppDir)threading;
        $(NitroModulesCppDir)utils;
        $(NitroModulesCppDir)views;
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalDependencies>shell32.lib;user32.lib;windowsapp.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <SubSystem>Console</SubSystem>
      <GenerateWindowsMetadata>true</GenerateWindowsMetadata>
      <ModuleDefinitionFile>NitroModules.def</ModuleDefinitionFile>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <PropertyGroup Label="UserMacros" />
  <ItemGroup>
    <ClInclude Include="NitroMsvcStdCompat.h" />
    <ClInclude Include="NitroModulesModule.h" />
    <ClInclude Include="ReactPackageProvider.h">
      <DependentUpon>ReactPackageProvider.idl</DependentUpon>
    </ClInclude>
    <ClInclude Include="threading\UIThreadDispatcher.hpp" />
    <ClInclude Include="pch.h" />
    <ClInclude Include="resource.h" />
    <ClInclude Include="targetver.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="NitroModulesModule.cpp" />
    <ClCompile Include="ReactPackageProvider.cpp">
      <DependentUpon>ReactPackageProvider.idl</DependentUpon>
    </ClCompile>
    <!-- C++/WinRT module glue (defines WINRT_GetActivationFactory / WINRT_CanUnloadNow
         referenced by NitroModules.def). -->
    <ClCompile Include="$(GeneratedFilesDir)module.g.cpp" />
    <ClCompile Include="platform\NitroLogger.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="platform\ThreadUtils.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="threading\UIThreadDispatcher.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
  </ItemGroup>
  <ItemGroup Label="Nitro C++ core (shared, ../../cpp)">
    <ClCompile Include="$(NitroModulesCppDir)core\AnyMap.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
    <ClCompile Include="$(NitroModulesCppDir)core\ArrayBuffer.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
    <ClCompile Include="$(NitroModulesCppDir)core\BoxedHybridObject.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
    <ClCompile Include="$(NitroModulesCppDir)core\HybridObject.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
    <ClCompile Include="$(NitroModulesCppDir)core\Promise.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
    <ClCompile Include="$(NitroModulesCppDir)entrypoint\HybridNitroModulesProxy.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
    <ClCompile Include="$(NitroModulesCppDir)entrypoint\InstallNitro.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
    <ClCompile Include="$(NitroModulesCppDir)jsi\JSICache.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
    <ClCompile Include="$(NitroModulesCppDir)prototype\HybridObjectPrototype.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
    <ClCompile Include="$(NitroModulesCppDir)registry\HybridObjectRegistry.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
    <ClCompile Include="$(NitroModulesCppDir)threading\Dispatcher.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
    <ClCompile Include="$(NitroModulesCppDir)threading\ThreadPool.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
    <ClCompile Include="$(NitroModulesCppDir)utils\CommonGlobals.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
    <ClCompile Include="$(NitroModulesCppDir)utils\NitroTypeInfo.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
    <ClCompile Include="$(NitroModulesCppDir)utils\PropNameIDCache.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
  </ItemGroup>
  <ItemGroup>
    <Midl Include="ReactPackageProvider.idl" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="NitroModules.rc" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ReactNativeWindowsTargets">
    <Import Project="$(ReactNativeWindowsDir)\PropertySheets\External\Microsoft.ReactNative.CppLib.targets" Condition="Exists('$(ReactNativeWindowsDir)\PropertySheets\External\Microsoft.ReactNative.CppLib.targets')" />
  </ImportGroup>
  <Target Name="EnsureReactNativeWindowsTargets" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <ErrorText>This project references targets in your node_modules\react-native-windows folder. The missing file is {0}.</ErrorText>
    </PropertyGroup>
    <Error Condition="!Exists('$(ReactNativeWindowsDir)\PropertySheets\External\Microsoft.ReactNative.CppLib.props')" Text="$([System.String]::Format('$(ErrorText)', '$(ReactNativeWindowsDir)\PropertySheets\External\Microsoft.ReactNative.CppLib.props'))" />
    <Error Condition="!Exists('$(ReactNativeWindowsDir)\PropertySheets\External\Microsoft.ReactNative.CppLib.targets')" Text="$([System.String]::Format('$(ErrorText)', '$(ReactNativeWindowsDir)\PropertySheets\External\Microsoft.ReactNative.CppLib.targets'))" />
  </Target>
  <Target Name="GenerateNitroIncludeShims" AfterTargets="EnsureReactNativeWindowsTargets">
    <PropertyGroup>
      <NitroShimScript>$([System.IO.Path]::GetFullPath('$(NitroModulesDir)scripts\generate-windows-shims.mjs'))</NitroShimScript>
      <NitroShimOutDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\include\NitroModules'))</NitroShimOutDir>
    </PropertyGroup>
    <Error Condition="!Exists('$(NitroShimScript)')" Text="Missing Nitro Windows shim generator: $(NitroShimScript)" />
    <Exec Command="node &quot;$(NitroShimScript)&quot; --out &quot;$(NitroShimOutDir)&quot; --nitro &quot;$(NitroModulesDir).&quot;" />
  </Target>
</Project>
